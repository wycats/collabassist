{
	"$schema": "https://json-schema.org/draft/2019-09/schema",
	"$id": "https://collabassist/cards.schema.json",
	"title": "Card",
	"description": "Union of supported AI UX card types.",
	"oneOf": [
		{ "$ref": "#/$defs/InterpretCard" },
		{ "$ref": "#/$defs/ProposeCard" },
		{ "$ref": "#/$defs/MockupCard" },
		{ "$ref": "#/$defs/LensCard" },
		{ "$ref": "#/$defs/ErrorCard" },
		{ "$ref": "#/$defs/SelectionSummaryCard" }
	],
	"$defs": {
		"BaseFields": {
			"type": "object",
			"properties": {
				"id": { "type": "string" },
				"title": { "type": "string", "minLength": 1 },
				"description": { "type": "string" },
				"flowId": { "type": "string" },
				"stepIndex": { "type": "integer", "minimum": 0 }
			},
			"required": ["id", "title"]
		},
		"InterpretOption": {
			"type": "object",
			"properties": {
				"id": { "type": "string" },
				"label": { "type": "string" },
				"summary": { "type": "string" }
			},
			"required": ["id", "label", "summary"],
			"additionalProperties": false
		},
		"ProposeOption": {
			"type": "object",
			"properties": {
				"id": { "type": "string" },
				"label": { "type": "string" },
				"summary": { "type": "string" }
			},
			"required": ["id", "label", "summary"],
			"additionalProperties": false
		},
		"MockupRegion": {
			"type": "object",
			"properties": {
				"id": { "type": "string" },
				"label": { "type": "string" },
				"layout": { "type": "string", "enum": ["shelf", "bookcase", "library"] },
				"role": { "type": "string", "enum": ["sidebar", "switcher", "content"] },
				"notes": { "type": "string" }
			},
			"required": ["id", "label", "layout"],
			"additionalProperties": false
		},
		"LensSection": {
			"type": "object",
			"properties": {
				"id": { "type": "string" },
				"label": { "type": "string" },
				"contents": {
					"type": "array",
					"items": { "type": "string" }
				}
			},
			"required": ["id", "label", "contents"],
			"additionalProperties": false
		},
		"LensPayload": {
			"type": "object",
			"properties": {
				"sections": {
					"type": "array",
					"items": { "$ref": "#/$defs/LensSection" }
				},
				"callsToAction": {
					"type": "array",
					"items": { "type": "string" }
				}
			},
			"required": ["sections", "callsToAction"],
			"additionalProperties": false
		},
		"InterpretCard": {
			"allOf": [
				{ "$ref": "#/$defs/BaseFields" },
				{
					"type": "object",
					"properties": {
						"kind": { "const": "interpret" },
						"options": {
							"type": "array",
							"items": { "$ref": "#/$defs/InterpretOption" },
							"minItems": 2,
							"maxItems": 5
						}
					},
					"required": ["kind", "options"]
				}
			],
			"unevaluatedProperties": false
		},
		"ProposeCard": {
			"allOf": [
				{ "$ref": "#/$defs/BaseFields" },
				{
					"type": "object",
					"properties": {
						"kind": { "const": "propose" },
						"options": {
							"type": "array",
							"items": { "$ref": "#/$defs/ProposeOption" },
							"minItems": 2,
							"maxItems": 5
						}
					},
					"required": ["kind", "options"]
				}
			],
			"unevaluatedProperties": false
		},
		"MockupCard": {
			"allOf": [
				{ "$ref": "#/$defs/BaseFields" },
				{
					"type": "object",
					"properties": {
						"kind": { "const": "mockup" },
						"regions": {
							"type": "array",
							"items": { "$ref": "#/$defs/MockupRegion" },
							"minItems": 1
						}
					},
					"required": ["kind", "regions"]
				}
			],
			"unevaluatedProperties": false
		},
		"LensCard": {
			"allOf": [
				{ "$ref": "#/$defs/BaseFields" },
				{
					"type": "object",
					"properties": {
						"kind": { "const": "lens" },
						"lensType": {
							"type": "string",
							"enum": ["entities", "flows", "screens", "permissions"]
						},
						"payload": { "$ref": "#/$defs/LensPayload" }
					},
					"required": ["kind", "lensType", "payload"]
				}
			],
			"unevaluatedProperties": false
		},
		"ErrorCard": {
			"allOf": [
				{ "$ref": "#/$defs/BaseFields" },
				{
					"type": "object",
					"properties": {
						"kind": { "const": "error" },
						"errorKind": {
							"type": "string",
							"enum": ["missing_info", "model_uncertain", "invalid_state"]
						},
						"details": { "type": "string" },
						"recoveryHint": { "type": "string" }
					},
					"required": ["kind", "errorKind"]
				}
			],
			"unevaluatedProperties": false
		},
		"SelectionSummaryCard": {
			"allOf": [
				{ "$ref": "#/$defs/BaseFields" },
				{
					"type": "object",
					"properties": {
						"kind": { "const": "selection-summary" },
						"selectionId": { "type": "string" },
						"selectionLabel": { "type": "string" },
						"selectionSummary": { "type": "string" },
						"sourceCardKind": { "type": "string", "enum": ["interpret", "propose"] }
					},
					"required": ["kind", "selectionId", "selectionLabel", "sourceCardKind"]
				}
			],
			"unevaluatedProperties": false
		}
	}
}
